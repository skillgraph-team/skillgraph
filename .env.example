# Copy to .env and fill in. Never commit .env.

# App: dev | test | prod
APP_ENV=dev

# Database (docker compose)
POSTGRES_USER=skillgraph
POSTGRES_PASSWORD=skillgraph
POSTGRES_DB=skillgraph
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://skillgraph:skillgraph@localhost:5432/skillgraph
TEST_DATABASE_URL=postgresql+psycopg://skillgraph:skillgraph@localhost:5432/skillgraph_test

# Auth (login token in an HttpOnly cookie, D-015)
# At least 32 characters. In production use a random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# How long a login lasts, in hours
LOGIN_LIFETIME_HOURS=24
# true when served over HTTPS (production); false for http://localhost
COOKIE_SECURE=false

# Uploaded CVs (M3.5): where files are stored (never a public folder) and the size limit.
# Without UPLOAD_DIR they go to backend/storage/uploads (git-ignored). Example:
# UPLOAD_DIR=/srv/skillgraph/uploads
CV_MAX_BYTES=5242880

# LLM (set after D-005)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# record | replay | live  (tests always use replay)
LLM_MODE=replay

# GitHub import (M3.6). Optional token: any GitHub account's personal access token with
# no scopes (public data only). Raises the limit from 60 to 5000 requests an hour.
GITHUB_TOKEN=
# How long saved GitHub answers are reused, in seconds, and how many repos are imported
# (10 fits the no-token limit; with a token, 20-30 is fine).
GITHUB_CACHE_SECONDS=3600
GITHUB_MAX_REPOS=10

# Frontend
# Where the browser sends API calls. /api goes through the Vite dev proxy (no CORS needed).
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api calls (the backend). Read by vite.config.ts only.
BACKEND_URL=http://localhost:8000
