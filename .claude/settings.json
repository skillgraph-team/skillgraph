{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm test)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/session_check.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/scripts/session_check.py\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Checking for teammates' new work..."
          }
        ]
      }
    ]
  }
}
